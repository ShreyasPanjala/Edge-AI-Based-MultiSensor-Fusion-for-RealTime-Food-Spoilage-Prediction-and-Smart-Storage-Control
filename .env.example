# Smart Food Storage Backend Configuration

# Application Host and Port
APP_NAME="Smart Food Storage Backend"
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Database Configuration (SQLite)
# Default is a local SQLite database in the backend directory
DATABASE_URL=sqlite:///./smart_food_storage.db

# Machine Learning Service Configuration
# ML_MODE can be "mock" (default for development) or "real" (loads trained model from MODEL_PATH)
ML_MODE=mock
MODEL_PATH=./ml/model.joblib

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins for frontend applications
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
